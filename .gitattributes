# 统一换行，避免跨平台 diff 噪音与批处理文件被写成 LF。
* text=auto

# Windows 批处理必须用 CRLF，否则 cmd.exe 解析可能出错。
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# 这些必须是 LF。
*.sh text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.vue text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 二进制，不做任何转换。
*.png binary
*.jpg binary
*.webp binary
*.woff2 binary
*.ico binary
